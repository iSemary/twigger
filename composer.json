{
  "name": "semary/twigger",
  "description": "Making a simple project using PHP native + twig",
  "type": "project",
  "autoload": {
    "psr-4": {
        "App\\" : "app/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@composer dump-autoload"
    ],
    "post-update-cmd": [
      "@composer dump-autoload"
    ]
  },
  "authors": [
    {
      "name": "Abdelrahman Samir",
      "email": "abdelrahmansamirmostafa@gmail.com"
    }
  ],
  "require": {
    "twig/twig": "^3.0",
    "vlucas/phpdotenv": "^5.4",
    "smarty/smarty": "^4.2"
  }
}
